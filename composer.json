{
  "name": "anil/fast-api-crud",
  "description": "A powerful Laravel package for building RESTful API CRUD operations with minimal boilerplate. Features pagination, filtering, sorting, soft deletes, permissions, lifecycle hooks, and more.",
  "keywords": [
    "laravel",
    "api",
    "crud",
    "rest",
    "controller",
    "eloquent",
    "pagination",
    "filter",
    "sort",
    "soft-delete",
    "permissions",
    "spatie"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "illuminate/auth": "^11.0||^12.0||^13.0",
    "illuminate/database": "^11.0||^12.0||^13.0",
    "illuminate/http": "^11.0||^12.0||^13.0",
    "illuminate/pagination": "^11.0||^12.0||^13.0",
    "illuminate/routing": "^11.0||^12.0||^13.0",
    "illuminate/support": "^11.0||^12.0||^13.0"
  },
  "suggest": {
    "spatie/laravel-permission": "Required to use permissionMiddleware() for role/permission-based access control (^6.0 or ^7.0)."
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.0",
    "orchestra/testbench": "^9.0||^10.0||^11.0",
    "pestphp/pest": "^3.0||^4.0",
    "spatie/laravel-permission": "^6.0||^7.0"
  },
  "autoload": {
    "psr-4": {
      "Anil\\FastApiCrud\\": "src/"
    },
    "files": [
      "src/Support/Helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Anil\\FastApiCrud\\Tests\\": "tests"
    }
  },
  "authors": [
    {
      "name": "Anil Kumar Thakur",
      "email": "anilkumarthakur60@gmail.com"
    }
  ],
  "extra": {
    "laravel": {
      "providers": [
        "Anil\\FastApiCrud\\FastApiCrudServiceProvider"
      ]
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "analyse": "vendor/bin/phpstan analyse",
    "lint": "vendor/bin/pint",
    "test": "vendor/bin/pest --parallel",
    "test-coverage": "vendor/bin/pest --coverage"
  }
}