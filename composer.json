{
  "name": "anil/fast-api-crud",
  "description": "Laravel Fast API CRUD with ease controller",
  "keywords": [
    "anil",
    "laravel",
    "api",
    "crud",
    "controller",
    "fast",
    "api-crud",
    "api-crud-controller",
    "fast-api-crud"
  ],
  "type": "library",
  "require": {
    "illuminate/auth": "^11.0||^12.0",
    "illuminate/database": "^11.0||^12.0",
    "illuminate/http": "^11.0||^12.0",
    "illuminate/pagination": "^11.0||^12.0",
    "illuminate/routing": "^11.0||^12.0",
    "illuminate/support": "^11.0||^12.0",
    "spatie/laravel-permission": "^5.0||^6.0"
  },
  "require-dev": {
    "larastan/larastan": "^2.0||^3.0",
    "laravel/pint": "^1.0",
    "orchestra/testbench": "^9.0||^10.0",
    "pestphp/pest": "^2.0||^3.0"
  },
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Anil\\FastApiCrud\\": "src/"
    },
    "files": [
      "src/Helper.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Anil\\FastApiCrud\\Tests\\": "tests"
    }
  },
  "authors": [
    {
      "name": "Anil Kumar Thakur",
      "email": "anilkumarthakur60@gmail.com"
    }
  ],
  "extra": {
    "laravel": {
      "providers": [
        "Anil\\FastApiCrud\\Providers\\ApiCrudServiceProvider"
      ]
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "pest": "vendor/bin/pest --parallel",
    "pest-coverage": "vendor/bin/pest --coverage",
    "pest-type": "vendor/bin/pest --type-coverage",
    "pint": "vendor/bin/pint"
  }
}
