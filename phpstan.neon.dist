includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    level: 9
    paths:
        - src/

    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        # Custom Eloquent builder macros registered at runtime
        - '#.*::initializer\(\)#'
        - '#.*::paginates\(\)#'
        - '#.*::simplePaginates\(\)#'
        - '#.*::cursorPaginates\(\)#'
        - '#.*::likeWhere\(\)#'

        # Traits not directly used by the package itself (used by consumers)
        - identifier: trait.unused
