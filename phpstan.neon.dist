includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    level: 10
    paths:
        - src/

    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        - '#.*::initializer\(\)#'
        - '#.*::paginates\(\)#'
        - '#.*::simplePaginates\(\)#'
        - '#.*::cursorPaginates\(\)#'
        - '#.*::likeWhere\(\)#'
        - '#.*::onlyTrashed\(\)#'
        - '#.*::restore\(\)#'
        -
            identifier: trait.unused
